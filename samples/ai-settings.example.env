# Example AI settings file for "Import from file..." in the app's Settings.
# Copy this to your own device, fill in YOUR values, and pick it in Settings.
# It is read in your browser only: never uploaded, and not saved until you
# press "Save on this device". Do NOT commit a filled-in copy anywhere.

ANTHROPIC_API_KEY=
# Work gateway token instead? Use this line (it also selects Bearer mode):
# ANTHROPIC_AUTH_TOKEN=

# Gateway address, without the trailing /v1 (blank = api.anthropic.com)
ANTHROPIC_BASE_URL=

# api_key (x-api-key), bearer (Authorization: Bearer), or both
PPTX_DEV_AUTH_MODE=

# Optional extra headers, one line, separated by \n
# PPTX_DEV_EXTRA_HEADERS=X-Tenant-Id: my-team

# The model id your gateway serves
PPTX_DEV_AI_MODEL=
