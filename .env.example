# Copy to ".env" (git-ignored) and edit. Read by docker-compose.yml.

# AI features. LEAVE THESE BLANK to enter your key/URL in the app's Settings
# (gear) modal instead: those stay only in your browser and are sent just with
# AI requests -- the container stores nothing. Anything set HERE is held by the
# container (and so usable by anyone who can reach the app).
ANTHROPIC_API_KEY=

# Only if you reach Claude through an Anthropic-API-compatible gateway (for
# example one in front of AWS Bedrock). Host only, no trailing /v1:
#   ANTHROPIC_BASE_URL=https://gateway.example.mil
ANTHROPIC_BASE_URL=

# How the key/token is sent: api_key (x-api-key, api.anthropic.com),
# bearer (Authorization: Bearer -- most work gateways; try this on a 401), or both.
PPTX_DEV_AUTH_MODE=api_key

# Optional extra gateway headers, one-line form: "X-Tenant-Id: my-team"
PPTX_DEV_EXTRA_HEADERS=

# Model name; for a Bedrock-style gateway use the gateway's own model id.
PPTX_DEV_AI_MODEL=claude-sonnet-5

# Where the app listens on THIS machine. Keep 127.0.0.1 (this computer only)
# unless an authenticating reverse proxy sits in front.
PPTX_DEV_BIND=127.0.0.1
PPTX_DEV_PORT=8000

# Build-time only: path to a PEM CA bundle, if your network inspects TLS and
# `docker compose build` fails with CERTIFICATE_VERIFY_FAILED. Not used at runtime.
#   PPTX_DEV_CA_BUNDLE=C:/certs/corp-ca.pem
#PPTX_DEV_CA_BUNDLE=
